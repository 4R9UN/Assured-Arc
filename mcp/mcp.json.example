{
  "$schema": "https://json.schemastore.org/mcp.json",
  "inputs": [],
  "servers": {
     "context7": {
       "type": "http",
       "url": "https://mcp.context7.com/mcp"
     },
     "sequential-thinking": {
       "type": "stdio",
       "command": "npx",
       "args": [
         "-y",
         "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
       ],
       "env": {
         "DISABLE_THOUGHT_LOGGING": "true"
       }
     },
     "arxiv": {
       "type": "stdio",
       "command": "__ARXIV_MCP_ENTRY__",
       "args": []
     }
  }
}
