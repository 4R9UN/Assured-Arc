        "linux": "python3 \"__HARNESS_HOOK_PY__\"",
        "osx": "python3 \"__HARNESS_HOOK_PY__\"",
        "timeout": 5,
        "env": {
          "ASSURED_ARC_HARNESS_CONFIG": "__HARNESS_CONFIG__",
          "ASSURED_ARC_HARNESS_TRACE_DIR": "__HARNESS_TRACE_DIR__",
